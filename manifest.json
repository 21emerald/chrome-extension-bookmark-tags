{
  "manifest_version": 3,
  "name": "bookmark-tags",
  "version": "1.11.1",
  "minimum_chrome_version": "123",
  "description": "Bookmark manager with tags, groups, favorites, content extraction & Google Drive sync",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "identity",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "534133388189-18mg43vt27koiierm7c71spsjoepk23u.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
